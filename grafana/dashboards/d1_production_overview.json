      "targets": [
        {
          "rawSql": "SELECT 'Actual' AS metric, COALESCE(MAX(total_count), 0) AS value FROM production_log WHERE machine_id = 1 UNION ALL SELECT 'Target', COALESCE(MAX(target_quantity), 4800) FROM production_target WHERE machine_id = 1 AND production_date = CURDATE();",
