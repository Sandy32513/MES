# ============================================================
# MES Project — Environment Variables (copy to .env, fill in)
# ============================================================

# MySQL
MYSQL_ROOT_PASSWORD=<change_me>
MES_ADMIN_PASSWORD=<change_me>
IGNITION_WRITER_PASSWORD=<change_me>
GRAFANA_READER_PASSWORD=<change_me>

# Ports (change only if defaults are taken)
MYSQL_PORT=3306
IGNITION_HTTP_PORT=8088
IGNITION_HTTPS_PORT=8043
GRAFANA_PORT=3000
OPC_UA_PORT=4840

# Plant timezone (IANA format)
PLANT_TIMEZONE=Asia/Kolkata
