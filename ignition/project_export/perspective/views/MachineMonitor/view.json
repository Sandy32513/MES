{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 768,
      "width": 1024
    }
  },
  "root": {
    "type": "ia.container.flex",
    "version": 0,
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "#121826",
        "padding": "24px",
        "fontFamily": "Segoe UI, sans-serif"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "version": 0,
        "props": {
          "text": "Screen 2: Machine Monitoring (Live Telemetry)",
          "style": {
            "color": "#ffffff",
            "fontSize": "26px",
            "fontWeight": "bold",
            "marginBottom": "20px"
          }
        }
      },
      {
        "type": "ia.container.flex",
        "version": 0,
        "props": {
          "direction": "row",
          "gap": "20px",
          "flexWrap": "wrap"
        },
        "children": [
          {
            "type": "ia.container.flex",
            "version": 0,
            "props": {
              "direction": "column",
              "style": {
                "backgroundColor": "#1e293b",
                "padding": "20px",
                "borderRadius": "8px",
                "minWidth": "250px",
                "border": "1px solid #334155"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "version": 0,
                "props": { "text": "Communication Status", "style": { "color": "#94a3b8", "fontSize": "14px", "marginBottom": "8px" } }
              },
              {
                "type": "ia.display.label",
                "version": 0,
                "props": {
                  "text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({[default]MES/Machine01/Comm_OK}, 'CONNECTED (GOOD)', 'DISCONNECTED (COMM LOSS)')"
                      }
                    }
                  },
                  "style": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({[default]MES/Machine01/Comm_OK}, '{\"color\":\"#22c55e\",\"fontSize\":\"20px\",\"fontWeight\":\"bold\"}', '{\"color\":\"#ef4444\",\"fontSize\":\"20px\",\"fontWeight\":\"bold\"}')"
                      }
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "version": 0,
            "props": {
              "direction": "column",
              "style": {
                "backgroundColor": "#1e293b",
                "padding": "20px",
                "borderRadius": "8px",
                "minWidth": "250px",
                "border": "1px solid #334155"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "version": 0,
                "props": { "text": "Live Machine Status", "style": { "color": "#94a3b8", "fontSize": "14px", "marginBottom": "8px" } }
              },
              {
                "type": "ia.display.label",
                "version": 0,
                "props": {
                  "text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({[default]MES/Machine01/Comm_OK}, if({[default]MES/Machine01/Machine_Status} = 0, 'STOP (0)', if({[default]MES/Machine01/Machine_Status} = 1, 'RUN (1)', 'IDLE (2)')), 'COMM LOSS (-1)')"
                      }
                    }
                  },
                  "style": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({[default]MES/Machine01/Comm_OK}, if({[default]MES/Machine01/Machine_Status} = 0, '{\"color\":\"#ef4444\",\"fontSize\":\"20px\",\"fontWeight\":\"bold\"}', if({[default]MES/Machine01/Machine_Status} = 1, '{\"color\":\"#22c55e\",\"fontSize\":\"20px\",\"fontWeight\":\"bold\"}', '{\"color\":\"#eab308\",\"fontSize\":\"20px\",\"fontWeight\":\"bold\"}')), '{\"color\":\"#94a3b8\",\"fontSize\":\"20px\",\"fontWeight\":\"bold\"}')"
                      }
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "version": 0,
            "props": {
              "direction": "column",
              "style": {
                "backgroundColor": "#1e293b",
                "padding": "20px",
                "borderRadius": "8px",
                "minWidth": "250px",
                "border": "1px solid #334155"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "version": 0,
                "props": { "text": "Machine Temperature", "style": { "color": "#94a3b8", "fontSize": "14px", "marginBottom": "8px" } }
              },
              {
                "type": "ia.display.label",
                "version": 0,
                "props": {
                  "text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "concat(numberFormat({[default]MES/Machine01/Temperature}, '#0.0'), ' °C')"
                      }
                    }
                  },
                  "style": {
                    "color": "#38bdf8",
                    "fontSize": "24px",
                    "fontWeight": "bold"
                  }
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "version": 0,
            "props": {
              "direction": "column",
              "style": {
                "backgroundColor": "#1e293b",
                "padding": "20px",
                "borderRadius": "8px",
                "minWidth": "250px",
                "border": "1px solid #334155"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "version": 0,
                "props": { "text": "Cycle Time", "style": { "color": "#94a3b8", "fontSize": "14px", "marginBottom": "8px" } }
              },
              {
                "type": "ia.display.label",
                "version": 0,
                "props": {
                  "text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "concat(numberFormat({[default]MES/Machine01/Cycle_Time}, '#0.000'), ' s')"
                      }
                    }
                  },
                  "style": {
                    "color": "#a855f7",
                    "fontSize": "24px",
                    "fontWeight": "bold"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
